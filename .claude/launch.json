{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "dev",
      "url": "http://localhost:5173"
    },
    {
      "name": "web-local",
      "runtimeExecutable": "deploy/dev.sh",
      "runtimeArgs": ["web-local"],
      "port": 5173,
      "autoPort": false
    },
    {
      "name": "stack",
      "runtimeExecutable": "/Applications/Docker.app/Contents/Resources/bin/docker",
      "runtimeArgs": ["compose", "-f", "deploy/docker-compose.yml", "up", "--build", "web"],
      "port": 5173,
      "autoPort": false
    }
  ]
}
