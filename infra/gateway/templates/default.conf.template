# Rendered at start by the nginx entrypoint; ${GATEWAY_*} and ${UPSTREAM_*} come from the environment.
resolver ${GATEWAY_RESOLVER} valid=10s ipv6=off;
map $http_upgrade $connection_upgrade { default upgrade; '' close; }

# A baseline policy on top of the shell's own (a meta tag with its script hashes, which cannot
# set frame-ancestors). Keycloak and Grafana send theirs; an empty value sends no header.
map $uri $d4_csp {
  ~^/(auth|grafana)/ '';
  default "frame-ancestors 'none'; base-uri 'self'; object-src 'none'; form-action 'self'";
}

# Slow or stalled clients and upstreams give up instead of holding connections.
client_header_timeout 15s;
client_body_timeout 60s;
send_timeout 60s;
proxy_connect_timeout 5s;

# localhost (D4_PUBLIC_URL): containers, or apps on the host where deploy/dev.sh points an upstream.
server {
  listen 8080 default_server;
  # HTTPS on 8443 when GATEWAY_TLS_CERT and GATEWAY_TLS_KEY are set (15-d4-gateway.envsh).
  include /etc/nginx/conf.d/*.tls;
  server_tokens off;
  # The API accepts 20 MB model imports.
  client_max_body_size 25m;

  gzip on;
  gzip_types application/json application/javascript text/css image/svg+xml text/plain;

  add_header X-Request-Id $request_id always;
  add_header X-Content-Type-Options nosniff always;
  add_header Referrer-Policy strict-origin-when-cross-origin always;
  add_header X-Frame-Options DENY always;
  add_header Content-Security-Policy $d4_csp always;

  proxy_http_version 1.1;
  proxy_set_header Host $http_host;
  proxy_set_header X-Request-Id $request_id;
  proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
  proxy_set_header X-Forwarded-Proto $scheme;
  # Includes the public port; no X-Forwarded-Port, which would be nginx's own (8080).
  proxy_set_header X-Forwarded-Host $http_host;
  proxy_set_header Upgrade $http_upgrade;
  proxy_set_header Connection $connection_upgrade;

  set $up_api ${UPSTREAM_API};
  set $up_keycloak ${UPSTREAM_KEYCLOAK};
  set $up_web ${UPSTREAM_WEB};
  set $up_web_modules ${UPSTREAM_WEB_MODULES};
  set $up_mail ${UPSTREAM_MAIL};
  set $up_grafana ${UPSTREAM_GRAFANA};
  set $up_s3 ${UPSTREAM_S3};
  set $up_mfe_dev ${UPSTREAM_MFE_DEV};

  include /etc/nginx/conf.d/apps.routes;
}

# ${GATEWAY_PODMAN_HOST} (D4_PODMAN_URL): always the containers, whatever deploy/dev.sh has moved to the host.
server {
  listen 8080;
  server_name ${GATEWAY_PODMAN_HOST};
  server_tokens off;
  # The API accepts 20 MB model imports.
  client_max_body_size 25m;

  gzip on;
  gzip_types application/json application/javascript text/css image/svg+xml text/plain;

  add_header X-Request-Id $request_id always;
  add_header X-Content-Type-Options nosniff always;
  add_header Referrer-Policy strict-origin-when-cross-origin always;
  add_header X-Frame-Options DENY always;
  add_header Content-Security-Policy $d4_csp always;

  proxy_http_version 1.1;
  proxy_set_header Host $http_host;
  proxy_set_header X-Request-Id $request_id;
  proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
  proxy_set_header X-Forwarded-Proto $scheme;
  # Includes the public port; no X-Forwarded-Port, which would be nginx's own (8080).
  proxy_set_header X-Forwarded-Host $http_host;
  proxy_set_header Upgrade $http_upgrade;
  proxy_set_header Connection $connection_upgrade;

  set $up_api ${UPSTREAM_PODMAN_API};
  set $up_keycloak ${UPSTREAM_PODMAN_KEYCLOAK};
  set $up_web ${UPSTREAM_PODMAN_WEB};
  set $up_web_modules ${UPSTREAM_PODMAN_WEB_MODULES};
  set $up_mail ${UPSTREAM_PODMAN_MAIL};
  set $up_grafana ${UPSTREAM_PODMAN_GRAFANA};
  set $up_s3 ${UPSTREAM_PODMAN_S3};
  # The containers only: no module from the host.
  set $up_mfe_dev 127.0.0.1:1;

  include /etc/nginx/conf.d/apps.routes;
}
