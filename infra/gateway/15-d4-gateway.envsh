#!/bin/sh
# Sourced by the nginx entrypoint before it renders templates (20-envsubst-on-templates.sh).
# The gateway shares the host network: it listens on GATEWAY_BIND:GATEWAY_PORT and reaches every
# component at 127.0.0.1:<port>, the same address whether it runs in Podman or on local Node, so
# moving a component between runtimes never changes the gateway (run/run.sh passes the ports).
: "${GATEWAY_PORT:?}" "${UPSTREAM_API:?}" "${UPSTREAM_KEYCLOAK:?}" "${UPSTREAM_WEB:?}" "${UPSTREAM_WEB_MODULES:?}" "${UPSTREAM_S3:?}"
export GATEWAY_BIND="${GATEWAY_BIND:-127.0.0.1}" GATEWAY_TLS_PORT="${GATEWAY_TLS_PORT:-5443}" GATEWAY_MFE_BUCKET="${GATEWAY_MFE_BUCKET:-d4-web-modules}"
rm -rf /tmp/d4-gateway && mkdir -p /tmp/d4-gateway /tmp/nginx-conf.d
cp /etc/d4-gateway/default.conf.template /etc/d4-gateway/apps.routes.template /tmp/d4-gateway/
# HTTPS only with a certificate and key (mounted files); otherwise plain HTTP behind a TLS proxy.
if [ -n "${GATEWAY_TLS_CERT:-}" ] && [ -n "${GATEWAY_TLS_KEY:-}" ]; then
  cp /etc/d4-gateway/public.tls.template /tmp/d4-gateway/
fi
# Developer consoles (/mail, /grafana) only in development.
if [ "${D4_ENV:-production}" = dev ]; then
  : "${UPSTREAM_MAIL:?}" "${UPSTREAM_GRAFANA:?}"
  cp /etc/d4-gateway/dev.locations.template /tmp/d4-gateway/
fi
# A web module run on local Node (run.sh local:web-<name>:deploy) listens on its own port; while
# it runs it serves /mfe/<name>/, otherwise the request falls through to the module image.
# GATEWAY_MODULES: "explore=8091 queries=8092 ...".
: > /tmp/nginx-conf.d/modules.mfe
for m in ${GATEWAY_MODULES:-}; do
  cat >> /tmp/nginx-conf.d/modules.mfe <<LOC
location /mfe/${m%%=*}/ {
  proxy_pass http://127.0.0.1:${m#*=};
  proxy_intercept_errors on;
  error_page 502 503 504 = @web_modules;
}
LOC
done
rm -f /etc/nginx/conf.d/default.conf /etc/nginx/conf.d/apps.routes /etc/nginx/conf.d/dev.locations /etc/nginx/conf.d/public.tls
