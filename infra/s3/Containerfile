# Development-only s3 mock: no runtime dependencies, so only its compiled files.
ARG NODE_IMAGE

FROM ${NODE_IMAGE} AS build
ARG NPM_REGISTRY
ARG NODE_EXTRA_CA_CERTS
COPY deploy/certs/ /etc/org-certs/
RUN if [ -s /etc/org-certs/org-ca.crt ]; then mkdir -p /etc/ssl/certs && cat /etc/org-certs/org-ca.crt >> /etc/ssl/certs/ca-certificates.crt; fi
ENV npm_config_registry=$NPM_REGISTRY COREPACK_NPM_REGISTRY=$NPM_REGISTRY
RUN corepack enable && corepack prepare pnpm@9.12.0 --activate
WORKDIR /repo
COPY pnpm-lock.yaml pnpm-workspace.yaml ./
RUN --mount=type=cache,id=pnpm,target=/root/.local/share/pnpm/store pnpm fetch
COPY . .
RUN --mount=type=cache,id=pnpm,target=/root/.local/share/pnpm/store \
    --mount=type=cache,id=turbo,target=/repo/.turbo/cache \
    pnpm install --offline --frozen-lockfile --filter d4 --filter '@d4/mock-s3...' \
 && pnpm exec turbo run build --filter '@d4/mock-s3...'

FROM ${NODE_IMAGE}
# Only `node` runs here: drop the package managers the base image ships (npm, corepack, yarn).
RUN rm -rf /usr/local/lib/node_modules /usr/local/bin/npm /usr/local/bin/npx /usr/local/bin/corepack /usr/local/bin/yarn /usr/local/bin/yarnpkg /opt/yarn-*
WORKDIR /app
COPY --from=build /repo/mocks/s3/dist ./dist
RUN mkdir /data && chown node:node /data
USER node
CMD ["node", "dist/main.js"]
