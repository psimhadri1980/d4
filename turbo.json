{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["tsconfig.base.json", "eslint.config.mjs", ".node-version"],
  "tasks": {
    "build": { "dependsOn": ["^build"], "outputs": ["dist/**"] },
    "typecheck": { "dependsOn": ["^build"] },
    "test": { "dependsOn": ["^build"], "env": ["D4_TEST_POSTGRES_URL", "D4_TEST_NEO4J_URL", "D4_TEST_NEO4J_PASSWORD", "D4_TEST_REDIS_URL", "D4_TEST_S3_ENDPOINT"] },
    "lint": {}
  }
}
