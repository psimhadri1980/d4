{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": { "dependsOn": ["^build"], "outputs": ["dist/**"] },
    "typecheck": { "dependsOn": ["^build"] },
    "test": { "dependsOn": ["^build"], "passThroughEnv": ["D4_TEST_POSTGRES_URL"] },
    "lint": {},
    "dev": { "cache": false, "persistent": true, "dependsOn": ["^build"] }
  }
}
