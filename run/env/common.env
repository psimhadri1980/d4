# Settings shared by every D4 app (services, web, tools), in Podman or on local Node. Loaded first;
# later layers win (run/run.sh merges them into run/.run/env/<runtime>/<component>.env):
#   common.env → images.env → host.conf (derived URLs) → what dependencies provide → the
#   component's own env (its component.yaml) → dev-secrets.env → local.env (git-ignored, yours)
# Infra components get only their own env. Flat KEY=value lines (no quotes, no ${...}).
# A variable already set in the calling shell wins over these files.

# Refuses development secrets and switches unless set to dev (see packages/config).
D4_ENV=dev

# Browser-facing addresses (D4_PUBLIC_URL, D4_PUBLIC_API_URL, OIDC_ISSUER) come from host.conf.

# Every process (container or local) shares the host network and listens on this address only.
D4_LISTEN_HOST=127.0.0.1

# Identity
OIDC_AUDIENCE=d4-api
OIDC_CLIENT_ID=d4-web

# Data stores (addresses come from the infra components' `provides`, secrets from dev-secrets.env)
POSTGRES_PORT=5432
POSTGRES_USER=d4
POSTGRES_DB=d4
NEO4J_USER=neo4j
S3_BUCKET=d4-exports

# Local S3 mock: buckets it creates at start
S3_MOCK_BUCKETS=d4-exports,d4-attachments,d4-backups,d4-web-modules
# Web module releases (D70): read by the gateway under /mfe/ without signing, written only by the API.
S3_MOCK_PUBLIC_BUCKETS=d4-web-modules
S3_WEB_MODULES_BUCKET=d4-web-modules

# Development only: webhooks and connector sources may use http:// and private addresses.
WEBHOOK_ALLOW_PRIVATE=true

# Organization trust (see run/certs/README.md). Where the files live is up to you: an absolute path,
# ~/..., or relative to run/. Leave empty to use files placed directly in run/certs, or none.
# ORG_CA_FILE: PEM bundle of your internal CA(s), trusted by builds, services, Keycloak and the renderer's Chromium.
ORG_CA_FILE=/etc/ssl/certs/ca-certificates.crt
# Gateway HTTPS (on D4_TLS_PORT from host.conf): the gateway's own certificate and key.
GATEWAY_TLS_CERT_FILE=
GATEWAY_TLS_KEY_FILE=
