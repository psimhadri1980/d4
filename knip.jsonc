{
  // Unused files, exports and dependencies: `pnpm knip`, `deploy/dev.sh check` and CI.
  // Mark an export that is deliberately kept with a `@public` JSDoc tag and say why.
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "workspaces": {
    ".": {},
    "apps/api": { "entry": ["src/scripts/*.ts"] },
    "apps/ops": { "entry": ["src/main.ts"] },
    "apps/e2e": { "entry": ["tests/**/*.ts", "screenshots/**/*.shots.ts", "*.config.ts"] },
    "packages/runtime": { "entry": ["src/index.ts", "src/telemetry.ts"] },
    // The browser build's entry (the `browser` export condition).
    "packages/metamodel": { "entry": ["src/index.ts", "src/browser.ts"] },
    "packages/cli": { "entry": ["src/index.ts", "src/main.ts"] },
    // The README example is compiled by the typecheck so the docs stay correct.
    "packages/sdk": { "entry": ["src/index.ts", "test/readme-example.ts"] },
    "packages/*": { "entry": ["src/index.ts"] },
    "mocks/*": { "entry": ["src/main.ts"] }
  },
  "ignore": ["packages/sdk/src/schema.ts"]
}
