{
  "realm": "d4",
  "enabled": true,
  "roles": {
    "realm": [
      {
        "name": "viewer"
      },
      {
        "name": "contributor"
      },
      {
        "name": "planner"
      },
      {
        "name": "architect"
      },
      {
        "name": "query-author"
      },
      {
        "name": "query-steward"
      },
      {
        "name": "admin"
      }
    ]
  },
  "clients": [
    {
      "clientId": "d4-web",
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "redirectUris": [
        "http://localhost:5173/*"
      ],
      "webOrigins": [
        "http://localhost:5173"
      ],
      "protocolMappers": [
        {
          "name": "audience-d4-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "d4-api",
            "access.token.claim": "true"
          }
        },
        {
          "name": "tenant",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "config": {
            "claim.name": "tenant",
            "claim.value": "t_local",
            "jsonType.label": "String",
            "access.token.claim": "true"
          }
        }
      ],
      "attributes": {
        "post.logout.redirect.uris": "http://localhost:5173/*",
        "pkce.code.challenge.method": "S256"
      }
    }
  ],
  "users": [
    {
      "username": "dev-admin",
      "enabled": true,
      "email": "dev-admin@d4.localhost",
      "emailVerified": true,
      "firstName": "Dev",
      "lastName": "Admin",
      "credentials": [
        {
          "type": "password",
          "value": "d4-local-dev",
          "temporary": false
        }
      ],
      "realmRoles": [
        "admin",
        "query-author",
        "query-steward"
      ]
    },
    {
      "username": "dev-viewer",
      "enabled": true,
      "email": "dev-viewer@d4.localhost",
      "emailVerified": true,
      "firstName": "Dev",
      "lastName": "Viewer",
      "credentials": [
        {
          "type": "password",
          "value": "d4-local-dev",
          "temporary": false
        }
      ],
      "realmRoles": [
        "viewer"
      ]
    },
    {
      "username": "dev-author",
      "enabled": true,
      "email": "dev-author@d4.localhost",
      "emailVerified": true,
      "firstName": "Dev",
      "lastName": "Author",
      "credentials": [
        {
          "type": "password",
          "value": "d4-local-dev",
          "temporary": false
        }
      ],
      "realmRoles": [
        "query-author",
        "viewer"
      ]
    },
    {
      "username": "dev-steward",
      "enabled": true,
      "email": "dev-steward@d4.localhost",
      "emailVerified": true,
      "firstName": "Dev",
      "lastName": "Steward",
      "credentials": [
        {
          "type": "password",
          "value": "d4-local-dev",
          "temporary": false
        }
      ],
      "realmRoles": [
        "query-steward",
        "viewer"
      ]
    }
  ]
}
