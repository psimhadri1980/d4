# Base and service images, pinned in one place. Loaded with the other env files (see common.env),
# so compose files interpolate them and the build scripts pass them to the Containerfiles as build args.
# Flat KEY=value lines only. Bump a version or digest here and nowhere else.

# npm registry for every install (image builds and host pnpm/npx). Point it at your organization's
# registry (Artifactory, Nexus, Verdaccio, ...) to use it everywhere; put it in local.env to keep it out of git.
NPM_REGISTRY=https://registry.npmjs.org

# Build bases (digest-pinned)
NODE_IMAGE=docker.io/library/node:24-alpine@sha256:8a32c8cf649a49915a66e81e7a609223c708d0adabf288ee3f4077d765542f85
NODE_SLIM_IMAGE=docker.io/library/node:24-bookworm-slim@sha256:c86ecead9e55a5210ac1727de38a4ca840bf03dcaf34dc9749addbf383b1920c
NGINX_IMAGE=docker.io/nginxinc/nginx-unprivileged:1.30-alpine@sha256:f5116ed4606f3eb015dd4a8e28cb9b351476dc0ad4bc6e9f93b19cec130cdf03
PLAYWRIGHT_IMAGE=mcr.microsoft.com/playwright:v1.47.2-jammy@sha256:eee5be766a342139241c9a51e6449cb8f6ff2847fbd0792f91793aaf0c7f4f46

# Data stores and identity
NEO4J_IMAGE=docker.io/library/neo4j:5.26-community
POSTGRES_IMAGE=docker.io/library/postgres:16-alpine
REDIS_IMAGE=docker.io/library/redis:7-alpine
KEYCLOAK_IMAGE=quay.io/keycloak/keycloak:25.0

# Observability
OTEL_COLLECTOR_IMAGE=docker.io/otel/opentelemetry-collector-contrib:0.108.0
TEMPO_IMAGE=docker.io/grafana/tempo:2.5.0
PROMETHEUS_IMAGE=docker.io/prom/prometheus:v2.54.1
GRAFANA_IMAGE=docker.io/grafana/grafana:11.2.0
