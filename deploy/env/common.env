# Settings shared by every D4 process, in containers or on the host. Loaded first; later files win:
#   common.env → container.env or host.env → dev-secrets.env → local.env (git-ignored, yours)
# Flat KEY=value lines only (no quotes, no ${...}), so bash, compose and `node --env-file` agree.
# A variable already set in the calling shell wins over these files when you run deploy/dev.sh.

# Refuses development secrets and switches unless set to dev (see packages/config).
D4_ENV=dev

# Browser-facing addresses. Keycloak's client redirect URIs follow D4_PUBLIC_URL.
D4_PUBLIC_URL=http://localhost:5173
D4_PUBLIC_API_URL=http://localhost:3000
KEYCLOAK_PUBLIC_URL=http://localhost:8080

# Identity
OIDC_ISSUER=http://localhost:8080/realms/d4
OIDC_AUDIENCE=d4-api
OIDC_CLIENT_ID=d4-web

# Data stores (host names are in container.env / host.env, secrets in dev-secrets.env)
POSTGRES_PORT=5432
POSTGRES_USER=d4
POSTGRES_DB=d4
NEO4J_USER=neo4j
S3_BUCKET=d4-exports

# Local S3 mock: buckets it creates at start
S3_MOCK_BUCKETS=d4-exports,d4-attachments,d4-backups

# Development only: webhooks and connector sources may use http:// and private addresses.
WEBHOOK_ALLOW_PRIVATE=true
