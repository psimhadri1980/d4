# Settings shared by every D4 process, in containers or on the host. Loaded first; later files win:
#   common.env → container.env or host.env → dev-secrets.env → local.env (git-ignored, yours)
# Flat KEY=value lines only (no quotes, no ${...}), so bash, compose and `node --env-file` agree.
# A variable already set in the calling shell wins over these files when you run deploy/dev.sh.

# Refuses development secrets and switches unless set to dev (see packages/config).
D4_ENV=dev

# Browser-facing addresses: everything goes through the gateway (port GATEWAY_PORT), the API under
# /api, Keycloak under /auth, each host on one origin. D4_PUBLIC_URL serves the containers or the
# apps deploy/dev.sh runs on local Node; D4_PODMAN_URL (host GATEWAY_PODMAN_HOST) always serves the
# containers. Keycloak's client redirect URIs cover both.
D4_PUBLIC_URL=http://localhost:5173
D4_PODMAN_URL=http://d4.localhost:5173
GATEWAY_PODMAN_HOST=d4.localhost
GATEWAY_PORT=5173
D4_PUBLIC_API_URL=http://localhost:5173/api

# Identity
OIDC_ISSUER=http://localhost:5173/auth/realms/d4
# Keycloak names its issuer after the host a sign-in came through; the API accepts these too.
OIDC_EXTRA_ISSUERS=http://d4.localhost:5173/auth/realms/d4
OIDC_AUDIENCE=d4-api
OIDC_CLIENT_ID=d4-web

# Data stores (host names are in container.env / host.env, secrets in dev-secrets.env)
POSTGRES_PORT=5432
POSTGRES_USER=d4
POSTGRES_DB=d4
NEO4J_USER=neo4j
S3_BUCKET=d4-exports

# Local S3 mock: buckets it creates at start
S3_MOCK_BUCKETS=d4-exports,d4-attachments,d4-backups,d4-web-modules
# Web module releases (D70): read by the gateway under /mfe/ without signing, written only by the API.
S3_MOCK_PUBLIC_BUCKETS=d4-web-modules
S3_WEB_MODULES_BUCKET=d4-web-modules

# Development only: webhooks and connector sources may use http:// and private addresses.
WEBHOOK_ALLOW_PRIVATE=true
