# How processes inside the compose network reach each service.
API_PORT=3000
POSTGRES_HOST=postgres
REDIS_URL=redis://redis:6379
S3_ENDPOINT=http://s3:8333
SMTP_URL=smtp://smtp:1025
# Tokens name the browser-facing issuer; signing keys come over the compose network.
OIDC_JWKS_URI=http://keycloak:8080/auth/realms/d4/protocol/openid-connect/certs
# Tenant Neo4j passwords (`file:` secret refs), written by `deploy/dev.sh tenant-create`.
NEO4J_SECRETS_DIR=/run/d4-secrets
