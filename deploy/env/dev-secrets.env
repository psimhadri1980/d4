# Local development credentials, gathered in one place. They exist only in this machine's stack;
# production supplies real values (or NAME_FILE=/run/secrets/name) through its platform, and the
# services refuse these values unless D4_ENV=dev.
POSTGRES_PASSWORD=d4-local-dev
NEO4J_PASSWORD=d4-local-dev
S3_ACCESS_KEY=d4
S3_SECRET_KEY=d4-local-dev
KEYCLOAK_ADMIN_PASSWORD=d4-local-dev
# Password of the dev-* users in the local realm and of users made by `dev.sh tenant-user`.
DEV_USER_PASSWORD=d4-local-dev
GRAFANA_ADMIN_PASSWORD=d4-local-dev
