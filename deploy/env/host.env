# How processes on the host (deploy/dev.sh api-local, worker-local, tenant tools) reach the
# services in containers. NEO4J_HOSTS and NEO4J_SECRETS_DIR are computed by deploy/dev.sh.
POSTGRES_HOST=localhost
REDIS_URL=redis://localhost:6379
S3_ENDPOINT=http://localhost:8333
SMTP_URL=smtp://localhost:1025

# Host processes run next to the containers: their own port and queues, so the container
# worker never takes their jobs.
API_PORT=3100
JOB_QUEUE=d4-jobs-local
RENDER_QUEUE=d4-render-local
WORKER_HEALTH_PORT=3102
# Off unless set (e.g. SCHEDULER_INTERVAL_MS=30000 deploy/dev.sh worker-local): schedules, the
# webhook outbox and backups live in the shared dev database, which the container worker serves.
SCHEDULER_INTERVAL_MS=0
WEBHOOK_INTERVAL_MS=0
BACKUP_HOUR_UTC=-1
