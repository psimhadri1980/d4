{
  "name": "@d4/renderer",
  "version": "0.0.1",
  "private": true,
  "description": "Renders roadmaps and graph views to PNG and PDF with headless Chromium (render queue).",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch src/main.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "lint": "eslint src test"
  },
  "dependencies": {
    "@d4/config": "workspace:*",
    "@d4/infra": "workspace:*",
    "@d4/jobs": "workspace:*",
    "@d4/runtime": "workspace:*",
    "@fontsource/source-sans-3": "catalog:",
    "playwright-core": "1.47.2",
    "zod": "catalog:"
  },
  "devDependencies": {
    "tsx": "catalog:",
    "@d4/render": "workspace:*"
  }
}
