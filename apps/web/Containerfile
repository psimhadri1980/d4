# Web app: static files served by unprivileged nginx; /config.json is written from the
# environment at start (deploy/web/config.sh), so one image serves any environment.
ARG NODE_IMAGE
ARG NGINX_IMAGE

FROM ${NODE_IMAGE} AS build
ARG NPM_REGISTRY
ARG NODE_EXTRA_CA_CERTS
COPY deploy/certs/ /etc/org-certs/
RUN if [ -s /etc/org-certs/org-ca.crt ]; then mkdir -p /etc/ssl/certs && cat /etc/org-certs/org-ca.crt >> /etc/ssl/certs/ca-certificates.crt; fi
ENV npm_config_registry=$NPM_REGISTRY COREPACK_NPM_REGISTRY=$NPM_REGISTRY
RUN corepack enable && corepack prepare pnpm@9.12.0 --activate
WORKDIR /repo
COPY pnpm-lock.yaml pnpm-workspace.yaml ./
RUN --mount=type=cache,id=pnpm,target=/root/.local/share/pnpm/store pnpm fetch
COPY . .
RUN --mount=type=cache,id=pnpm,target=/root/.local/share/pnpm/store \
    --mount=type=cache,id=turbo,target=/repo/.turbo/cache \
    pnpm install --offline --frozen-lockfile --filter d4 --filter '@d4/web...' \
 && pnpm exec turbo run build --filter '@d4/web...'

FROM ${NGINX_IMAGE}
# Alpine fixes published after this digest (brotli, curl, ...); the image runs as nginx (101).
USER root
# Organization CA (deploy/certs) for the apk mirror or proxy.
COPY deploy/certs/ /etc/org-certs/
RUN if [ -s /etc/org-certs/org-ca.crt ]; then mkdir -p /etc/ssl/certs && cat /etc/org-certs/org-ca.crt >> /etc/ssl/certs/ca-certificates.crt; fi
RUN apk upgrade --no-cache
USER 101
COPY deploy/web/nginx.conf /etc/nginx/conf.d/default.conf
COPY --chmod=755 deploy/web/config.sh /docker-entrypoint.d/40-d4-config.sh
COPY --from=build /repo/apps/web/dist /usr/share/nginx/html
EXPOSE 8080
