# Web shell (static files behind the gateway); /config.json is written at start (config.sh).
# Thin image: run/run.sh builds on the host and stages app/ (apps/web/dist), component/ (this folder) and certs/.
ARG NGINX_IMAGE
FROM ${NGINX_IMAGE}
USER root
COPY certs/ /etc/org-certs/
RUN if [ -s /etc/org-certs/org-ca.crt ]; then mkdir -p /etc/ssl/certs && cat /etc/org-certs/org-ca.crt >> /etc/ssl/certs/ca-certificates.crt; fi
RUN apk upgrade --no-cache
USER 101
COPY component/nginx.conf /etc/nginx/conf.d/default.conf
COPY --chmod=755 component/config.sh /docker-entrypoint.d/40-d4-config.sh
COPY app/ /usr/share/nginx/html
