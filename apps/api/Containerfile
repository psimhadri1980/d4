# API (NestJS). Build context: the repository root. Only the workspaces the API needs are
# installed and built, then `pnpm deploy` copies the API with its production dependencies.
ARG NODE_IMAGE

# Only this app's workspaces: files outside them (another app, docs) leave the layers below cached.
FROM ${NODE_IMAGE} AS prune
ARG NPM_REGISTRY
ARG NODE_EXTRA_CA_CERTS
COPY deploy/certs/ /etc/org-certs/
RUN if [ -s /etc/org-certs/org-ca.crt ]; then mkdir -p /etc/ssl/certs && cat /etc/org-certs/org-ca.crt >> /etc/ssl/certs/ca-certificates.crt; fi
ENV npm_config_registry=$NPM_REGISTRY COREPACK_NPM_REGISTRY=$NPM_REGISTRY
RUN npm install -g turbo@2.11.9
WORKDIR /repo
COPY . .
RUN turbo prune @d4/api --docker

FROM ${NODE_IMAGE} AS build
ARG NPM_REGISTRY
ARG NODE_EXTRA_CA_CERTS
COPY deploy/certs/ /etc/org-certs/
RUN if [ -s /etc/org-certs/org-ca.crt ]; then mkdir -p /etc/ssl/certs && cat /etc/org-certs/org-ca.crt >> /etc/ssl/certs/ca-certificates.crt; fi
ENV npm_config_registry=$NPM_REGISTRY COREPACK_NPM_REGISTRY=$NPM_REGISTRY
RUN corepack enable && corepack prepare pnpm@9.12.0 --activate
WORKDIR /repo
COPY --from=prune /repo/out/pnpm-lock.yaml /repo/out/pnpm-workspace.yaml ./
RUN --mount=type=cache,id=pnpm,target=/root/.local/share/pnpm/store pnpm fetch
COPY --from=prune /repo/out/json/ ./
COPY --from=prune /repo/out/full/ ./
# Root config the pruned workspaces build with (turbo prune leaves it out).
COPY tsconfig.base.json ./
RUN --mount=type=cache,id=pnpm,target=/root/.local/share/pnpm/store \
    --mount=type=cache,id=turbo,target=/repo/.turbo/cache \
    pnpm install --offline --frozen-lockfile --filter d4 --filter '@d4/api...' \
 && pnpm exec turbo run build --filter '@d4/api...' \
 && pnpm --filter @d4/api deploy --prod /app

FROM ${NODE_IMAGE}
# Organization CA (deploy/certs): system store for git and curl, NODE_EXTRA_CA_CERTS for Node.
ARG NODE_EXTRA_CA_CERTS
COPY deploy/certs/ /etc/org-certs/
RUN if [ -s /etc/org-certs/org-ca.crt ]; then mkdir -p /etc/ssl/certs && cat /etc/org-certs/org-ca.crt >> /etc/ssl/certs/ca-certificates.crt; fi
ENV NODE_EXTRA_CA_CERTS=$NODE_EXTRA_CA_CERTS
# Only `node` runs here: drop the package managers the base image ships (npm, corepack, yarn).
RUN rm -rf /usr/local/lib/node_modules /usr/local/bin/npm /usr/local/bin/npx /usr/local/bin/corepack /usr/local/bin/yarn /usr/local/bin/yarnpkg /opt/yarn-*
ENV NODE_ENV=production
WORKDIR /app
COPY --from=build --chown=node:node /app .
USER node
EXPOSE 3000
CMD ["node", "--enable-source-maps", "dist/main.js"]
