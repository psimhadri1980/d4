# The web modules image (service web-modules): every apps/web-<name> (built) under /mfe/<name>/, and the plain JavaScript
# hello module under /mfe/hello/. Releases can also be uploaded instead (deploy/mfe-publish.sh, D70).
ARG NODE_IMAGE
ARG NGINX_IMAGE

FROM ${NODE_IMAGE} AS build
ARG NPM_REGISTRY
ARG NODE_EXTRA_CA_CERTS
COPY deploy/certs/ /etc/org-certs/
RUN if [ -s /etc/org-certs/org-ca.crt ]; then mkdir -p /etc/ssl/certs && cat /etc/org-certs/org-ca.crt >> /etc/ssl/certs/ca-certificates.crt; fi
ENV npm_config_registry=$NPM_REGISTRY COREPACK_NPM_REGISTRY=$NPM_REGISTRY
RUN corepack enable && corepack prepare pnpm@9.12.0 --activate
WORKDIR /repo
COPY pnpm-lock.yaml pnpm-workspace.yaml ./
RUN --mount=type=cache,id=pnpm,target=/root/.local/share/pnpm/store pnpm fetch
COPY . .
RUN --mount=type=cache,id=pnpm,target=/root/.local/share/pnpm/store \
    --mount=type=cache,id=turbo,target=/repo/.turbo/cache \
    pnpm install --offline --frozen-lockfile --filter d4 --filter '@d4/web-*...' \
 && pnpm exec turbo run build --filter '@d4/web-*' \
 && mkdir -p /mfe \
 && for d in apps/web-*/dist; do n=${d#apps/web-}; cp -r "$d" "/mfe/${n%/dist}"; done

FROM ${NGINX_IMAGE}
# Alpine fixes published after this digest (brotli, curl, ...); the image runs as nginx (101).
USER root
# Organization CA (deploy/certs) for the apk mirror or proxy.
COPY deploy/certs/ /etc/org-certs/
RUN if [ -s /etc/org-certs/org-ca.crt ]; then mkdir -p /etc/ssl/certs && cat /etc/org-certs/org-ca.crt >> /etc/ssl/certs/ca-certificates.crt; fi
RUN apk upgrade --no-cache
USER 101
COPY deploy/web-modules/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /mfe /usr/share/nginx/html/mfe
COPY apps/web-hello/hello.js /usr/share/nginx/html/mfe/hello/hello.js
EXPOSE 8080
