# The six lifecycle web modules and web-hello, served under /mfe/<name>/ behind the gateway.
# Thin image: run/run.sh builds on the host and stages app/ (one folder per module: app/<name>/), component/ (this folder) and certs/.
ARG NGINX_IMAGE
FROM ${NGINX_IMAGE}
USER root
COPY certs/ /etc/org-certs/
RUN if [ -s /etc/org-certs/org-ca.crt ]; then mkdir -p /etc/ssl/certs && cat /etc/org-certs/org-ca.crt >> /etc/ssl/certs/ca-certificates.crt; fi
RUN apk upgrade --no-cache
USER 101
COPY component/nginx.conf /etc/nginx/conf.d/default.conf
COPY app/ /usr/share/nginx/html/mfe
