# Rendered only when GATEWAY_TLS_CERT and GATEWAY_TLS_KEY are set: HTTPS for the public host.
listen 8443 ssl;
http2 on;
ssl_certificate ${GATEWAY_TLS_CERT};
ssl_certificate_key ${GATEWAY_TLS_KEY};
ssl_protocols TLSv1.2 TLSv1.3;
ssl_session_cache shared:d4tls:10m;
ssl_session_timeout 1h;
add_header Strict-Transport-Security "max-age=31536000" always;
