# The routes both hosts serve; each server sets the $up_* upstreams first.
location = /healthz { access_log off; default_type text/plain; return 200 'ok'; }

# The API keeps its own routes (/v1/..., /graphql, /healthz): /api is stripped.
location /api/ {
  set $u $up_api;
  rewrite ^/api/(.*)$ /$1 break;
  proxy_pass http://$u;
  proxy_read_timeout 120s;
}
# Keycloak serves under /auth itself (KC_HTTP_RELATIVE_PATH).
location /auth/ {
  set $u $up_keycloak;
  proxy_pass http://$u;
  proxy_buffer_size 16k;
  proxy_buffers 8 16k;
}

# Uploaded web module releases (D70): read-only from the bucket, versioned and immutable.
location /mfe/_r/ {
  limit_except GET { deny all; }
  set $u $up_s3;
  # The version is in the path; the trailing ? drops any query (the shell's ?v=), which S3 would treat as a sub-resource.
  rewrite ^/mfe/_r/(.*)$ /${GATEWAY_MFE_BUCKET}/$1? break;
  proxy_set_header Authorization "";
  proxy_set_header Cookie "";
  proxy_hide_header x-amz-request-id;
  proxy_hide_header x-amz-id-2;
  proxy_pass http://$u;
}

# A web module rebuilt on the host by deploy/dev.sh web-<name> (502 when none runs).
location /mfe/_dev/ {
  set $u $up_mfe_dev;
  proxy_pass http://$u;
}

# Web modules built into the module image (seeded admin and hello).
location /mfe/ {
  set $u $up_web_modules;
  proxy_pass http://$u;
}

include /etc/nginx/conf.d/*.locations;

location / {
  set $u $up_web;
  proxy_pass http://$u;
}
