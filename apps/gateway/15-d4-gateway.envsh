#!/bin/sh
# Sourced by the nginx entrypoint before it renders templates (20-envsubst-on-templates.sh).
# Picks the templates for this environment and the DNS server upstream names resolve through.
: "${UPSTREAM_API:?}" "${UPSTREAM_KEYCLOAK:?}" "${UPSTREAM_WEB:?}"
# Resolving per request keeps the gateway up while an upstream is stopped or moved (502 instead).
export GATEWAY_RESOLVER="${GATEWAY_RESOLVER:-$(awk '/^nameserver/ { print $2; exit }' /etc/resolv.conf)}"
# nginx's resolver asks DNS only, so names from /etc/hosts (host.containers.internal, which
# deploy/dev.sh uses for apps on the host) become their address here.
for v in UPSTREAM_API UPSTREAM_KEYCLOAK UPSTREAM_WEB UPSTREAM_WEB_ADMIN UPSTREAM_MAIL UPSTREAM_GRAFANA; do
  eval "u=\${$v:-}"
  ip=$(awk -v h="${u%%:*}" '$1 !~ /^#/ { for (i = 2; i <= NF; i++) if ($i == h) { print $1; exit } }' /etc/hosts)
  [ -n "$ip" ] && export "$v=$ip:${u##*:}"
done
rm -rf /tmp/d4-gateway && mkdir -p /tmp/d4-gateway
cp /etc/d4-gateway/default.conf.template /tmp/d4-gateway/
# Developer consoles (/mail, /grafana) only in development.
if [ "${D4_ENV:-production}" = dev ]; then
  : "${UPSTREAM_MAIL:?}" "${UPSTREAM_GRAFANA:?}"
  cp /etc/d4-gateway/dev.locations.template /tmp/d4-gateway/
fi
rm -f /etc/nginx/conf.d/default.conf /etc/nginx/conf.d/dev.locations
