# Job worker. Build context: the repository root (see apps/api/Containerfile).
ARG NODE_IMAGE=docker.io/library/node:24-alpine@sha256:8a32c8cf649a49915a66e81e7a609223c708d0adabf288ee3f4077d765542f85

# Only this app's workspaces: files outside them (another app, docs) leave the layers below cached.
FROM ${NODE_IMAGE} AS prune
RUN npm install -g turbo@2.11.9
WORKDIR /repo
COPY . .
RUN turbo prune @d4/worker --docker

FROM ${NODE_IMAGE} AS build
RUN corepack enable && corepack prepare pnpm@9.12.0 --activate
WORKDIR /repo
COPY --from=prune /repo/out/pnpm-lock.yaml /repo/out/pnpm-workspace.yaml ./
RUN --mount=type=cache,id=pnpm,target=/root/.local/share/pnpm/store pnpm fetch
COPY --from=prune /repo/out/json/ ./
COPY --from=prune /repo/out/full/ ./
# Root config the pruned workspaces build with (turbo prune leaves it out).
COPY tsconfig.base.json ./
RUN --mount=type=cache,id=pnpm,target=/root/.local/share/pnpm/store \
    --mount=type=cache,id=turbo,target=/repo/.turbo/cache \
    pnpm install --offline --frozen-lockfile --filter d4 --filter '@d4/worker...' \
 && pnpm exec turbo run build --filter '@d4/worker...'
RUN pnpm --filter @d4/worker deploy --prod /app

FROM ${NODE_IMAGE}
# Only `node` runs here: drop the package managers the base image ships (npm, corepack, yarn).
RUN rm -rf /usr/local/lib/node_modules /usr/local/bin/npm /usr/local/bin/npx /usr/local/bin/corepack /usr/local/bin/yarn /usr/local/bin/yarnpkg /opt/yarn-*
# git: the Git model-as-code connector clones repositories.
RUN apk add --no-cache git
ENV NODE_ENV=production
WORKDIR /app
COPY --from=build --chown=node:node /app .
USER node
CMD ["node", "--enable-source-maps", "dist/main.js"]
