# Development-only smtp mock: no runtime dependencies, so only its compiled files.
ARG NODE_IMAGE=docker.io/library/node:24-alpine

FROM ${NODE_IMAGE} AS build
RUN corepack enable && corepack prepare pnpm@9.12.0 --activate
WORKDIR /repo
COPY pnpm-lock.yaml pnpm-workspace.yaml ./
RUN --mount=type=cache,id=pnpm,target=/root/.local/share/pnpm/store pnpm fetch
COPY . .
RUN --mount=type=cache,id=pnpm,target=/root/.local/share/pnpm/store \
    pnpm install --offline --frozen-lockfile --filter d4 --filter '@d4/mock-smtp...' \
 && pnpm --filter '@d4/mock-smtp...' run build

FROM ${NODE_IMAGE}
WORKDIR /app
COPY --from=build /repo/mocks/smtp/dist ./dist
USER node
CMD ["node", "dist/main.js"]
