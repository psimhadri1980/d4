{
  "name": "@d4/db",
  "version": "0.0.1",
  "private": true,
  "description": "Postgres control plane: Drizzle schema, migrations and stores.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": ["dist", "drizzle"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "lint": "eslint src test",
    "generate": "drizzle-kit generate",
    "migrate": "node dist/migrate.js",
    "seed:local": "node dist/seed-local.js"
  },
  "dependencies": {
    "@d4/core": "workspace:*",
    "@d4/metamodel": "workspace:*",
    "drizzle-orm": "^0.33.0",
    "pg": "^8.12.0"
  },
  "devDependencies": {
    "@types/pg": "^8.11.6",
    "drizzle-kit": "^0.24.2"
  }
}
