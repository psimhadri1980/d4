{
  "name": "@d4/render",
  "version": "0.0.1",
  "private": true,
  "description": "Static pictures of views (roadmap Gantt, graph neighbourhood) as SVG; shared by the web app and the renderer.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsup src/index.ts --format esm --sourcemap --no-config --silent",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "lint": "eslint src test"
  },
  "dependencies": {
    "@d4/core": "workspace:*",
    "@d4/metamodel": "workspace:*"
  },
  "devDependencies": {
    "@d4/codecs": "workspace:*",
    "tsup": "catalog:"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "browser": "./dist/index.mjs",
      "default": "./dist/index.js"
    }
  }
}
