{
  "name": "@d4/sdk",
  "version": "0.1.0",
  "private": true,
  "description": "Typed client for the D4 REST API, generated from its OpenAPI document.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": ["dist", "openapi.json", "README.md"],
  "scripts": {
    "generate": "node ../../apps/api/dist/scripts/openapi.js openapi.json && openapi-typescript openapi.json -o src/schema.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "lint": "eslint src test"
  },
  "devDependencies": {
    "openapi-typescript": "7.4.1"
  }
}
